{
  "name": "flywire-linguist",
  "version": "1.0.0",
  "description": "Biologically grounded synaptic language acquisition and real-time speech synthesis driven by the FlyWire Drosophila melanogaster mushroom body connectome.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5178 --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run_all_benchmarks.mjs",
    "benchmark:2afc": "node scripts/benchmark_two_choice_associative_learning.mjs",
    "benchmark:sequence": "node scripts/benchmark_compositional_generalization.mjs",
    "verify:connectome": "python3 scripts/extract_flywire_synapses.py --verify"
  },
  "keywords": [
    "connectome",
    "drosophila",
    "flywire",
    "neuroscience",
    "synaptic-plasticity",
    "mushroom-body",
    "speech-synthesis",
    "threejs",
    "web-audio"
  ],
  "author": "d1tokirb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/d1tokirb/FlyWire-Linguist.git"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
